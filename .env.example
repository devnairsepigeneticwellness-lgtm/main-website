# Nair's Epigenetic Wellness (N.E.W.) - Environment Configuration

# -----------------------------------------------------------------------------
# Supabase Configuration (Events, Gallery, Bookings, Availability & Auth)
# -----------------------------------------------------------------------------
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Supabase Service Role Key for server-side administrative overrides
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# Email & Contact Configuration
# -----------------------------------------------------------------------------
# Optional: Resend API Key for automatic email notifications on consultation bookings & enquiries
RESEND_API_KEY=

# Recipient email for contact enquiries (defaults to approved client email: ajit.navy@gmail.com)
CONTACT_EMAIL_RECIPIENT=ajit.navy@gmail.com

# -----------------------------------------------------------------------------
# Cloudinary Configuration (Admin Photo & Event Flyer Uploads)
# -----------------------------------------------------------------------------
# Obtain these from your Cloudinary Dashboard -> Programmable Media -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional root folder inside Cloudinary Media Library
CLOUDINARY_UPLOAD_FOLDER=nairsepigeneticwellness

# -----------------------------------------------------------------------------
# Cloudinary Media Storage (Admin Event Posters & Gallery Photographs)
# -----------------------------------------------------------------------------
# Obtain from Cloudinary Dashboard -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional root folder in Cloudinary (defaults to nairsepigeneticwellness)
CLOUDINARY_UPLOAD_FOLDER=nairsepigeneticwellness
